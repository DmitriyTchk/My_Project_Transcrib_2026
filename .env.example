# ============================================================
# VibeScribe Studio — переменные окружения
# Скопируйте файл в .env и заполните нужные значения.
# Все ключи опциональны: приложение работает полностью локально
# с faster-whisper; облачные движки включаются только при наличии ключей.
# ============================================================

# --- Локальный Whisper-сервер (основной сценарий) ---
# URL OpenAI-совместимого эндпоинта транскрибации локального сервера
# (используется, если клиент не передал свой URL в настройках).
# Для docker-compose: http://whisper:8000/v1/audio/transcriptions
LOCAL_WHISPER_ENDPOINT="http://localhost:8000/v1/audio/transcriptions"

# API-ключ локального Whisper-сервера (передаётся как Authorization: Bearer ...).
# Должен совпадать с WHISPER__API_KEY контейнера faster-whisper-server.
LOCAL_WHISPER_API_KEY="my-secret-token"

# --- Облачные движки (опционально) ---

# GEMINI_API_KEY: для облачной транскрибации и AI-функций (резюме, перевод, советник).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Groq — быстрый облачный Whisper (опционально).
GROQ_API_KEY=""

# OpenAI Whisper API (опционально).
OPENAI_API_KEY=""

# Deepgram Nova (опционально).
DEEPGRAM_API_KEY=""

# Hugging Face токен (опционально, для отдельных моделей).
HUGGINGFACE_TOKEN=""

# APP_URL: URL, где размещено приложение (для self-referential ссылок и OAuth).
APP_URL="http://localhost:3000"

# ============================================================
# Защита приложения паролем (обязательно для доступа из интернета!)
# ============================================================
# Логин для HTTP Basic авторизации (браузер покажет диалог входа).
APP_USER="admin"

# Пароль для HTTP Basic авторизации.
# Если оставить ПУСТЫМ — авторизация выключена (подходит только для localhost).
# Если планируете открывать доступ через ngrok/интернет — ОБЯЗАТЕЛЬНО задайте пароль!
APP_PASSWORD=""

# ============================================================
# Уведомления о публичном адресе (для ngrok-share.ps1, опционально)
# ============================================================
# Telegram: создайте бота через @BotFather и вставьте его токен.
# TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
# Узнать свой chat_id можно через бота @userinfobot.
# TELEGRAM_CHAT_ID="123456789"

# Email-уведомления через SMTP (например, smtp.yandex.ru / smtp.gmail.com).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_TO="notify@example.com"

# Порт локального приложения, который пробрасывает ngrok (по умолчанию 8000).
# NGROK_PORT="8000"
